import turtle as t
import random
t.speed(0)
t.bgcolor("black")
t.color("white")
t.pencolor("white")
t.colormode(255)
n = 120
for j in range(4):
    for i in range(n):
        t.forward(n - i)
        t.left(30 * ((i % 3) + 1))
        t.color((random.randint(0, 255), random.randint(0, 255), random.randint(0, 255)))
    t.penup()
    t.home()
    t.pendown()
    t.right(90 * (j+1))
t.exitonclick()
t.hideturtle()
